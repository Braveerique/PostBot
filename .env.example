# PostBot Configuration
# Copy this file to .env and fill in your actual credentials

# Twitter API Credentials (Free tier available)
# Get these from: https://developer.twitter.com/
TWITTER_API_KEY=your_twitter_api_key_here
TWITTER_API_SECRET=your_twitter_api_secret_here
TWITTER_ACCESS_TOKEN=your_twitter_access_token_here
TWITTER_ACCESS_TOKEN_SECRET=your_twitter_access_token_secret_here
TWITTER_BEARER_TOKEN=your_twitter_bearer_token_here

# Bluesky Credentials (Free)
# Create an app password at: https://bsky.app/settings/app-passwords
BLUESKY_HANDLE=yourhandle.bsky.social
BLUESKY_PASSWORD=your_bluesky_app_password_here

# Facebook Page Credentials (Free)
# Get these from: https://developers.facebook.com/
FACEBOOK_PAGE_ACCESS_TOKEN=your_facebook_page_access_token_here
FACEBOOK_PAGE_ID=your_facebook_page_id_here

# YouTube Credentials (Free)
# Get these from: https://console.cloud.google.com/
YOUTUBE_CLIENT_ID=your_youtube_client_id_here
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret_here
YOUTUBE_CHANNEL_ID=your_youtube_channel_id_here

# Instagram Credentials (Free)
# Get these from: https://developers.facebook.com/docs/instagram-basic-display-api/
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token_here
INSTAGRAM_USER_ID=your_instagram_user_id_here

# Twitch Configuration (for stream detection)
TWITCH_USERNAME=your_twitch_username_here
TWITCH_CLIENT_ID=your_twitch_client_id_here
TWITCH_CLIENT_SECRET=your_twitch_client_secret_here

# OBS WebSocket Configuration (alternative stream detection method)
OBS_WEBSOCKET_PASSWORD=your_obs_websocket_password
OBS_WEBSOCKET_PORT=4455

# Stream Configuration
STREAM_TITLE=My Awesome Stream
STREAM_GAME=Just Chatting
CHECK_INTERVAL=30

# Custom Message Templates (optional)
TWITTER_MESSAGE_TEMPLATE=🔴 LIVE NOW! {title}\n\nPlaying: {game}\n\nCome hang out! 👇\n{stream_url}
BLUESKY_MESSAGE_TEMPLATE=🔴 Going live! {title}\n\nCurrently playing: {game}\n\nJoin the stream: {stream_url}
FACEBOOK_MESSAGE_TEMPLATE=🎮 Live streaming now!\n\n{title}\n\nGame: {game}\n\nWatch here: {stream_url}
YOUTUBE_MESSAGE_TEMPLATE=🔴 LIVE: {title}\n\nNow playing: {game}\n\nJoin us live: {stream_url}
INSTAGRAM_MESSAGE_TEMPLATE=🔴 Going live now!\n\n{title}\n\nGame: {game}\n\nWatch at: {stream_url}\n\n#LiveStream #Gaming #Twitch